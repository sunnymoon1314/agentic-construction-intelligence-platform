# ACIP S03: Agentic Cost & Commercial Control Intelligence Environment Configuration

# Server Port Configuration
PORT=8086

# Local Storage Mode
DUCKDB_PATH=data/commercial_control.duckdb
PARQUET_DIR=data/parquet

# Approach 3 Cloud Object Storage Lakehouse Mode (Leave empty for local DuckDB/Parquet)
# AWS S3: s3://acip-commercial-lake-prod
# GCP GCS: gs://acip-commercial-lake-prod
# Azure Blob: https://acipstorage.blob.core.windows.net/commercial-lake
COMMERCIAL_LAKE_BUCKET=""

# Default Scenario Project
DEFAULT_PROJECT_ID=PRJ-WHC-COM-001
DEFAULT_CLAIM_ID=CLM-WHC-008

# Statutory SOPA Compliance Settings
STATUTORY_RESPONSE_DAYS_CEILING=14
PSSCOC_TIMEBAR_LIMIT_DAYS=28
OPENBIM_VARIANCE_TOLERANCE_PCT=2.0
MOM_SWO_DAILY_IDLE_CHARGE=12500.00
MOM_SDP_PER_POINT_CHARGE=1500.00
MOM_FINE_MARKUP_PCT=15.0

# Cloud Service Provider (CSP) Credentials & Model Settings
CLOUD_PROVIDER="LOCAL"

# Amazon Web Services (AWS)
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_DEFAULT_REGION="ap-southeast-1"
AWS_REGION="ap-southeast-1"

# Microsoft Azure
AZURE_STORAGE_ACCOUNT="your_azure_storage_account"
AZURE_CONTAINER_NAME="commercial-lake"

# Google Cloud Platform (GCP)
GCP_PROJECT_ID="your_gcp_project_id"
GCP_REGION="asia-southeast1"
