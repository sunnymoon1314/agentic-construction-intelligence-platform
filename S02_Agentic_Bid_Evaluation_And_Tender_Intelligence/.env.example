# ACIP S02: Agentic Bid Evaluation & Tender Intelligence Environment Configuration

# Data store
DUCKDB_PATH=data/hospital_tender.duckdb

# Tender project
TENDER_ID=TND-WHC-2026-001
PROJECT_NAME="Woodlands Health Campus Acute Care Wing"
BENCHMARK_CURRENCY=SGD
BENCHMARK_PTE=120000000.00

# BCA Price-Quality Method weights (must sum to 1.0)
PRICE_WEIGHT=0.50
QUALITY_WEIGHT=0.50

# Forensic thresholds
Z_SCORE_THRESHOLD=1.5
EARLY_WORKS_SKEW_LIMIT=1.30

# =========================================================
# Cloud Service Provider (CSP) Credentials & Model Settings
# =========================================================
CLOUD_PROVIDER="LOCAL"

# Amazon Web Services (AWS Bedrock)
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_DEFAULT_REGION="ap-southeast-1"
AWS_REGION="ap-southeast-1"

# Microsoft Azure (Azure OpenAI)
AZURE_OPENAI_ENDPOINT="https://your-resource-name.openai.azure.com/"

# Google Cloud Platform (Vertex AI & Artifact Registry)
GCP_PROJECT_ID="your_gcp_project_id"
GCP_DOCKER_IMAGE="gcr.io/your_gcp_project_id/enterprise-mcp-server:latest"
