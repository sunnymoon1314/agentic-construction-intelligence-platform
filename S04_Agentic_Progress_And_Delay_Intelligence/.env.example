# ACIP S04: Agentic Progress & Delay Intelligence Environment Configuration

# Server Port Configuration
PORT=8087

# Local Storage Mode
PARQUET_DIR=data/parquet

# Approach 3 Cloud Object Storage Lakehouse Mode (Leave empty for local DuckDB/Parquet)
# AWS S3: s3://acip-progress-delay-lake-prod
# GCP GCS: gs://acip-progress-delay-lake-prod
# Azure Blob: https://acipstorage.blob.core.windows.net/progress-delay-lake
PROGRESS_DELAY_LAKE_BUCKET=""

# Default Scenario Project & Delay Event
DEFAULT_PROJECT_ID=PRJ-WHC-COM-001
DEFAULT_DELAY_EVENT_ID=DLY-2026-001

# Statutory PSSCOC & Delay Protocol Compliance Settings
PSSCOC_NOTICE_WINDOW_DAYS=28
SCL_PROTOCOL_EDITION=2
LIQUIDATED_DAMAGES_DAILY_RATE=15000.00
WEATHER_RAIN_THRESHOLD_MM=10.0

# Cloud Service Provider (CSP) Credentials & Model Settings
CLOUD_PROVIDER="LOCAL"

# Amazon Web Services (AWS)
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_DEFAULT_REGION="ap-southeast-1"
AWS_REGION="ap-southeast-1"

# Microsoft Azure (Azure OpenAI & Container Apps)

# Google Cloud Platform (GCP Vertex AI & Cloud Run)
GCP_PROJECT_ID="your_gcp_project_id"
GCP_REGION="asia-southeast1"
