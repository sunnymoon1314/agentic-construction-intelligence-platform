# Valid values for CLOUD_PROVIDER: "LOCAL", "AWS", "AZURE", "GCP"
CLOUD_PROVIDER="LOCAL"

# ---------------------------------------------------------
# Optional API Keys (Only needed if NOT using "LOCAL")
# ---------------------------------------------------------

# If using "AWS" (Amazon Nova Pro via Bedrock):
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_DEFAULT_REGION="us-east-1"

# If using "AZURE" (GPT-4o / Azure OpenAI with Entra ID):
AZURE_OPENAI_ENDPOINT="https://your-resource-name.openai.azure.com/"

# If using "GCP" (Gemini 2.5 Pro via Vertex AI):
GCP_PROJECT_ID="your-gcp-project-id"
GCP_DOCKER_IMAGE="gcr.io/your-gcp-project-id/enterprise-mcp-server:latest"
